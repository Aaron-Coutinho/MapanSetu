# Certificate Service environment variables
# Copy this file to .env and fill in real values

PORT=8003
PYTHON_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mapansetu_certs
DB_USER=postgres
DB_PASSWORD=changeme

# Object Storage (MinIO for local dev, swap to S3 for prod)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=mapansetu-certificates
MINIO_USE_SSL=false

# HSM / eSign (C-DAC — sandbox for prototype)
CDAC_ESIGN_URL=https://esign-prep.cdac.in/esign20
CDAC_ESIGN_TOKEN=changeme

# IAM Service
IAM_SERVICE_URL=http://localhost:8080
