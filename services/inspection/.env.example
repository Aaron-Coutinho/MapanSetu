# Inspection Service environment variables
# Copy this file to .env and fill in real values

PORT=8081
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mapansetu_inspection
DB_USER=postgres
DB_PASSWORD=changeme

# Object Storage (for geotagged photos and e-signatures)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=mapansetu-inspections
MINIO_USE_SSL=false

# IAM Service
IAM_SERVICE_URL=http://localhost:8080

# Registry Service
REGISTRY_SERVICE_URL=http://localhost:8090
