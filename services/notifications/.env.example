# Notifications Service environment variables
# Copy this file to .env and fill in real values

PORT=8002
PYTHON_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mapansetu_notifications
DB_USER=postgres
DB_PASSWORD=changeme

# Redis
REDIS_URL=redis://localhost:6379

# Kafka (skip for prototype — use Redis queue directly)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_EXPIRY=mapansetu.expiry.reminders

# SMS (sandbox)
SMS_PROVIDER_URL=https://api.sandbox-sms-provider.in
SMS_API_KEY=changeme

# WhatsApp Business API (sandbox)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_ID=changeme
WHATSAPP_TOKEN=changeme

# Email (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=changeme
SMTP_PASSWORD=changeme
SMTP_FROM=noreply@mapansetu.gov.in

# IAM Service
IAM_SERVICE_URL=http://localhost:8080
