# IAM Service environment variables
# Copy this file to .env and fill in real values

# Server
PORT=8080
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mapansetu_iam
DB_USER=postgres
DB_PASSWORD=changeme

# Keycloak
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=mapansetu
KEYCLOAK_CLIENT_ID=iam-service
KEYCLOAK_CLIENT_SECRET=changeme

# JWT
JWT_SECRET=changeme-use-rsa-key-in-prod
JWT_EXPIRY_MINUTES=60

# eKYC (Aadhaar / PAN / DigiLocker) — sandbox endpoints for prototype
AADHAAR_API_URL=https://sandbox.uidai.gov.in
DIGILOCKER_API_URL=https://digilocker.meripehchaan.gov.in
